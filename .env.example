# Copy to .env.local for local development, and add the same keys in Vercel.

# --- Phase 1 (required now) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Later phases (not used yet) ---
SUPABASE_SERVICE_ROLE_KEY=      # server only: QR redirect + client portal (phases 3-4)
IP_HASH_SALT=                   # random 32+ chars (phase 3)
PORTAL_JWT_SECRET=              # random 32+ chars (phase 4)
RESEND_API_KEY=                 # phase 4
DIGEST_TO_EMAIL=                # phase 4
FROM_EMAIL=                     # e.g. cards@helloshiftsolutions.com, verified in Resend
CRON_SECRET=                    # phase 4
QR_BASE_URL=https://q.helloshiftsolutions.com
FALLBACK_URL=https://helloshiftsolutions.com
STRIPE_WEBHOOK_SECRET=          # phase 5
